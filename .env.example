# ==============================================================================
# VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# Copia este archivo a .env.local y define tus credenciales reales
# ==============================================================================

# 1. SQL Server Local (Opcional para réplica local)
DB_SERVER=localhost\SQLEXPRESS
DB_USER=sa
# DB_PASSWORD= <TU_PASSWORD>
DB_NAME=BolaDeNieve

# 2. Clave secreta para firma HMAC de sesiones JWT (Generar cadena aleatoria de 64 caracteres)
# SESSION_SECRET=<GENERATE_SECURE_RANDOM>

# 3. Supabase (Opcional para modo nube)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-publica
# Clave privada de servicio exclusiva del backend (NUNCA exponer en el cliente ni con prefijo NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=<YOUR_SERVICE_ROLE_KEY>
